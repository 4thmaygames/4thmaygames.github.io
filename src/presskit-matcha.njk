---
permalink: /presskit/matcha/
eleventyExcludeFromCollections: true
---
{% set c = press.common %}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.titleJa }} / {{ c.titleEn }} — Press Kit | 4th May Games</title>
<meta name="description" content="{{ press.en.lead }}">
<meta name="robots" content="index, follow">

<meta property="og:type" content="article">
<meta property="og:site_name" content="4th May Games">
<meta property="og:title" content="{{ c.titleEn }} — Press Kit">
<meta property="og:description" content="{{ press.en.lead }}">
<meta property="og:image" content="{{ site.url }}/presskit/matcha/assets/logo/keyart.webp">
<meta property="og:url" content="{{ site.url }}/presskit/matcha/">
<meta name="twitter:card" content="summary_large_image">

<link rel="canonical" href="{{ site.url }}/presskit/matcha/">
<link rel="icon" href="/assets/images/common/favicon.png" type="image/png">

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/presskit/matcha/press.css">
</head>
<body>

<header class="pk-top">
  <div class="pk-wrap pk-top-in">
    <a class="pk-home" href="/">
      <img src="/assets/images/common/logo.png" alt="4th May Games" height="26">
    </a>
    <nav class="pk-langs" aria-label="Language">
      <button type="button" data-lang="ja" aria-pressed="true">日本語</button>
      <button type="button" data-lang="en" aria-pressed="false">English</button>
      <button type="button" data-lang="ko" aria-pressed="false">한국어</button>
    </nav>
  </div>
</header>

{% for code in ["ja", "en", "ko"] %}
{% set t = press[code] %}
<div class="pk-doc" data-doc="{{ code }}"{% if code != "ja" %} hidden{% endif %}>

  <section class="pk-hero">
    <div class="pk-wrap">
      <p class="pk-kicker">{{ t.kicker }}</p>
      <h1 class="pk-title">
        {% if code == "ja" %}{{ c.titleJa }}{% elif code == "ko" %}{{ c.titleKo }}{% else %}{{ c.titleEn }}{% endif %}
      </h1>
      {% if code != "en" %}<p class="pk-title-sub">{{ c.titleEn }}</p>{% endif %}
      <p class="pk-tagline">{{ t.tagline }}</p>
      <p class="pk-lead">{{ t.lead }}</p>
    </div>
    <div class="pk-wrap pk-keyart">
      <img src="/presskit/matcha/assets/logo/keyart.webp" alt="{{ c.titleEn }}" width="1024" height="500">
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.fact }}</h2>
      <dl class="pk-facts">
        <div><dt>{{ t.factLabels.title }}</dt><dd>{% if code == "ja" %}{{ c.titleJa }}{% elif code == "ko" %}{{ c.titleKo }}{% else %}{{ c.titleEn }}{% endif %} <span class="pk-dim">/ {{ c.titleEn }}</span></dd></div>
        <div><dt>{{ t.factLabels.developer }}</dt><dd>{{ c.developer[code] }}</dd></div>
        <div><dt>{{ t.factLabels.release }}</dt><dd><strong>{{ c.releaseDate[code] }}</strong></dd></div>
        <div><dt>{{ t.factLabels.platform }}</dt><dd>{{ c.platforms }}</dd></div>
        <div><dt>{{ t.factLabels.price }}</dt><dd>{{ c.price[code] }}</dd></div>
        <div><dt>{{ t.factLabels.genre }}</dt><dd>{{ c.genre[code] }}</dd></div>
        <div><dt>{{ t.factLabels.languages }}</dt><dd>{{ c.languages[code] }}</dd></div>
        <div><dt>{{ t.factLabels.site }}</dt><dd><a href="{{ c.website }}">4thmaygames.com</a></dd></div>
      </dl>
      <p class="pk-store">
        <a class="pk-badge" href="{{ c.googleplay }}" target="_blank" rel="noopener">
          <img src="/assets/images/common/badge-googleplay-prereg.png" alt="Google Play" width="565" height="168">
        </a>
        {% if c.appstore %}
        <a class="pk-badge" href="{{ c.appstore }}" target="_blank" rel="noopener">
          <img src="/assets/images/common/badge-appstore-preorder.png" alt="App Store" width="503" height="168">
        </a>
        {% endif %}
      </p>
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.about }}</h2>
      <div class="pk-prose">
        {% for p in t.about %}<p>{{ p }}</p>{% endfor %}
      </div>
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.features }}</h2>
      <ol class="pk-features">
        {% for f in t.features %}
        <li><h3>{{ f.t }}</h3><p>{{ f.d }}</p></li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.screens }}</h2>
      <div class="pk-grid pk-grid--shots">
        {% for n in [1,2,3,4,5,6] %}
        <figure><img src="/presskit/matcha/assets/screenshots/shot-{{ n }}.webp" alt="Screenshot {{ n }}" width="720" height="1280" loading="lazy"></figure>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.art }}</h2>
      <div class="pk-grid pk-grid--art">
        {% for n in [1,2,3,4] %}
        <figure><img src="/presskit/matcha/assets/artwork/art-{{ n }}.webp" alt="Artwork {{ n }}" width="720" height="1280" loading="lazy"></figure>
        {% endfor %}
      </div>
      <p class="pk-note">{{ t.assetsNote }}</p>
      <p><a class="pk-btn" href="/presskit/matcha/frog-matcha-cafe-presskit.zip" download>{{ t.download }} ↓</a></p>
    </div>
  </section>

  <section class="pk-sec">
    <div class="pk-wrap">
      <h2>{{ t.sections.studio }}</h2>
      <div class="pk-prose">
        {% for p in t.studio %}<p>{{ p }}</p>{% endfor %}
      </div>
      <ul class="pk-credits">
        {% for cr in t.credits %}
        <li><strong>{{ cr.t }}</strong><span>{{ cr.d }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="pk-sec pk-contact">
    <div class="pk-wrap">
      <h2>{{ t.sections.contact }}</h2>
      <p>{{ t.contact }}</p>
      <p class="pk-mail"><a href="mailto:{{ c.email }}">{{ c.email }}</a></p>
    </div>
  </section>

</div>
{% endfor %}

<footer class="pk-foot">
  <div class="pk-wrap">
    <p>© {{ site.copyrightYear }} 4th May Games. All rights reserved.</p>
    <p class="pk-updated">Last updated: {{ press.updated }}</p>
  </div>
</footer>

<script>
(function () {
  var docs = document.querySelectorAll("[data-doc]");
  var btns = document.querySelectorAll("[data-lang]");
  var LANGS = ["ja", "en", "ko"];

  function apply(lang) {
    if (LANGS.indexOf(lang) < 0) lang = "ja";
    docs.forEach(function (d) { d.hidden = d.getAttribute("data-doc") !== lang; });
    btns.forEach(function (b) { b.setAttribute("aria-pressed", String(b.getAttribute("data-lang") === lang)); });
    document.documentElement.lang = lang;
    try { history.replaceState(null, "", "#" + lang); } catch (e) {}
  }

  var initial = (location.hash || "").replace("#", "");
  if (LANGS.indexOf(initial) < 0) {
    var nav = (navigator.language || "en").toLowerCase();
    initial = nav.indexOf("ja") === 0 ? "ja" : nav.indexOf("ko") === 0 ? "ko" : "en";
  }
  apply(initial);

  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      apply(b.getAttribute("data-lang"));
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
})();
</script>
</body>
</html>

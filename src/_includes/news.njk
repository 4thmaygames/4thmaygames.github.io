---
layout: base.njk
---
<article class="news-article">
  <div class="wrap prose">
    <a class="back" href="/news/">← 목록으로</a>

    <div class="news-meta">
      <time datetime="{{ date | isoDate }}">{{ date | dateKR }}</time>
      {% if source %}<span class="news-source">{{ source }}</span>{% endif %}
    </div>

    <h1>{{ title }}</h1>

    {% if image %}
    <div class="media ratio-16-9 hero-img" data-label="{{ title }}">
      <img src="{{ image }}" alt="" width="1280" height="720">
    </div>
    {% endif %}

    {{ content | safe }}

    {% if link %}
    <p class="source-link">
      <a class="btn btn--ghost" href="{{ link }}" target="_blank" rel="noopener">원문 기사 보기 ↗</a>
    </p>
    {% endif %}
  </div>
</article>

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} · {{ site.nameEn }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/images/common/favicon.png" type="image/png">

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="{{ site.name }} 홈">
      <img src="/assets/images/common/logo.png" alt="{{ site.name }}" height="28"
           onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'logo-text',textContent:'4TH MAY GAMES'}))">
    </a>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-logo">4TH MAY GAMES</p>
      <p class="footer-tag">설렘이 가득한 5월 4일처럼!</p>
    </div>
    <div class="footer-links">
      <a href="/privacy/">개인정보처리방침</a>
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© {{ site.copyrightYear }} {{ site.nameEn }}. All rights reserved.</p>
  </div>
</footer>

<script src="/assets/js/main.js" defer></script>
</body>
</html>

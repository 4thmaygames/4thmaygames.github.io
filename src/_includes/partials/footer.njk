<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">4TH MAY GAMES</p>
      <p class="footer-tag">설렘이 가득한 5월 4일처럼!</p>
    </div>

    <nav class="footer-nav" aria-label="푸터 메뉴">
      <div class="footer-col">
        <p class="footer-head">Games</p>
        <ul>
          {% for g in games %}<li><a href="/{{ g.slug }}/">{{ g.title }}</a></li>{% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-head">About</p>
        <ul>
          <li><a href="/company/">회사 소개</a></li>
          <li><a href="/value/">핵심 가치</a></li>
          <li><a href="{{ site.careersUrl }}" target="_blank" rel="noopener">팀원 모집 ↗</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-head">More</p>
        <ul>
          <li><a href="/news/">News</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p class="legal">
      <!-- TODO: 사업자 정보를 채워주세요 -->
      {{ site.name }}{% if site.email %} · <a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
    </p>
    <p class="copy">© {{ site.copyrightYear }} {{ site.nameEn }}. All rights reserved.</p>
  </div>
</footer>
